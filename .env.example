NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://cert:cert_local_only@localhost:55432/cert_app
REDIS_URL=redis://localhost:56379
STORAGE_ROOT=./.runtime/storage
# Replace with >=32 random characters; use a separate secret store in production.
SESSION_SECRET=replace-this-local-secret-with-32-random-characters
MAIL_MODE=mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=51025
# Mailpit is a local-only mail sink. Production uses MAIL_MODE=smtp, see docs/EMAIL_SETUP.md.
WORKER_CONCURRENCY=2
# Docker defaults to false; native Linux enables Chromium sandbox when unset.
# CHROMIUM_SANDBOX=false
SEED_ADMIN_EMAIL=admin@example.test
# Development seed only. Set your own password before seeding.
SEED_ADMIN_PASSWORD=Local-Cert-Only-2026!
