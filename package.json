{
  "name": "cert-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,worker,web 'pnpm dev:api' 'pnpm dev:worker' 'pnpm dev:web'",
    "dev:api": "tsx --env-file=.env --watch apps/api/src/index.ts",
    "dev:worker": "tsx --env-file=.env --watch apps/worker/src/index.ts",
    "dev:web": "pnpm --filter @cert/web dev",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "build": "pnpm --filter @cert/web build && tsc --noEmit",
    "start:api": "tsx --env-file=.env apps/api/src/index.ts",
    "start:worker": "tsx --env-file=.env apps/worker/src/index.ts"
  },
  "dependencies": {
    "@cert/config": "workspace:*",
    "@cert/contracts": "workspace:*",
    "@cert/domain": "workspace:*",
    "@cert/renderer": "workspace:*",
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "10.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "bullmq": "6.3.15",
    "csv-parse": "7.0.3",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "fastify": "5.12.7",
    "fflate": "^0.8.3",
    "ioredis": "^5.10.0",
    "nodemailer": "10.1.1",
    "pg": "^8.16.3",
    "sharp": "0.35.5",
    "yauzl": "^3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yauzl": "^3.4.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.0",
    "jsqr": "1.4.0",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.50.0",
    "vitest": "5.0.4"
  }
}
