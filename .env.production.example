# Production settings for docker compose (compose.yaml + compose.production.yaml [+ compose.cloudflare.yaml]).
# Copy outside the repository, e.g. /secure/cert-app-production.env, fill in, and pass with --env-file.
# Not the same as .env.example, which is for local `pnpm dev` with Mailpit. See docs/DEPLOYMENT.md.

# Public address
APP_DOMAIN=cert.fearnot.tw
DOCKER_APP_ORIGIN=https://cert.fearnot.tw

# Secrets: long random values, e.g. `openssl rand -base64 48`
POSTGRES_PASSWORD=
SESSION_SECRET=

# Mail (docs/EMAIL_SETUP.md). Leave MAIL_MODE=disabled to start without email.
MAIL_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
