# Production settings for compose.production.yaml. On the server: cp .env.production.example .env
# then fill in and run `docker compose -f compose.production.yaml up --build -d`.
# Not the same as .env.example, which is for local `pnpm dev` with Mailpit. See docs/DEPLOYMENT.md.

# Public address
APP_DOMAIN=cert.fearnot.tw
CHROMIUM_SANDBOX=false
DOCKER_APP_ORIGIN=https://cert.fearnot.tw

# Secrets: long random letters/digits, e.g. `openssl rand -hex 32` (the DB password goes into a URL)
POSTGRES_PASSWORD=
SESSION_SECRET=

# Mail (docs/EMAIL_SETUP.md). Leave MAIL_MODE=disabled to start without email.
MAIL_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
