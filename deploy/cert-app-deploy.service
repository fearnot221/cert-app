[Unit]
Description=Certificate app signed GitHub CI deployment webhook
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=%h/.config/cert-app-deploy.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=%h/cert-app
# Refresh the Docker group even when the user manager predates group membership.
ExecStart=/usr/bin/sg docker -c "/usr/bin/python3 %h/cert-app/deploy/webhook.py"
Restart=always
RestartSec=5
TimeoutStopSec=60
KillMode=control-group
# Checkout/build inputs must remain readable by non-root container users.
# The secret env file and state.json are explicitly created with mode 0600.
UMask=0022

[Install]
WantedBy=default.target
