# Used by compose.cloudflare.yaml when the DNS record is proxied by Cloudflare (orange cloud).
# Cloudflare SSL/TLS mode must be "Full (strict)"; the origin certificate comes from
# Cloudflare dashboard > SSL/TLS > Origin Server and is mounted at /certs.
{
	servers {
		# Keep the visitor address Cloudflare puts in X-Forwarded-For. Same list as
		# CLOUDFLARE_IP_RANGES in packages/config; https://www.cloudflare.com/ips/
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

{$APP_DOMAIN} {
	tls /certs/origin.pem /certs/origin.key
	reverse_proxy web:8080
}
